---
import type { CollectionEntry } from 'astro:content';
import { fmtUAH, percentOf } from '../lib/format';
import React from 'react';
import type { IconType } from 'react-icons';
import { renderToStaticMarkup } from 'react-dom/server';
import { FiAlertTriangle, FiCheck, FiCheckCircle, FiCopy, FiDownload, FiEdit3, FiRotateCcw, FiTrash2 } from 'react-icons/fi';
import TemplateLockup from './brand/TemplateLockup.astro';
import TplPhotoSlot from './TplPhotoSlot.astro';

interface Props {
  fund: CollectionEntry<'fundraiser'>['data'];
  page: CollectionEntry<'templatesPage'>['data'];
}
const { fund, page } = Astro.props;

// Server-rendered initial values so the canvases look correct before the
// client script hydrates. The client then merges any localStorage overrides.
const percent = percentOf(fund.raised, fund.goal);
const raisedFmt = fmtUAH(fund.raised);
const goalFmt = fmtUAH(fund.goal);
const remainingFmt = fmtUAH(Math.max(0, fund.goal - fund.raised));

const initial = {
  titleMain: fund.titleMain,
  titleAccent: fund.titleAccent,
  desc: fund.desc,
  goal: fund.goal,
  raised: fund.raised,
  photo: null,
  labels: page.studio.labels,
};

const iconMarkup = (icon: IconType) =>
  renderToStaticMarkup(
    React.createElement(icon, {
      size: 14,
      'aria-hidden': true,
      focusable: false,
    })
  );

const actionIcons = {
  download: iconMarkup(FiDownload),
  copy: iconMarkup(FiCopy),
  edit: iconMarkup(FiEdit3),
  done: iconMarkup(FiCheck),
  reset: iconMarkup(FiRotateCcw),
  remove: iconMarkup(FiTrash2),
  // Feedback icons paired with the success/error action tooltips
  // («Збережено» / «Скопійовано» vs. their «Помилка …» variants).
  success: iconMarkup(FiCheckCircle),
  error: iconMarkup(FiAlertTriangle),
};
---

<div class="studio">
  <!-- Mobile-only: floating opener + backdrop for the fields drawer -->
  <button type="button" id="studio-drawer-toggle" class="drawer-toggle" aria-controls="studio-panel" aria-expanded="false">{page.studio.drawerToggle}</button>
  <div id="studio-drawer-backdrop" class="drawer-backdrop"></div>

  <!-- ============ FIELDS PANEL ============ -->
  <aside id="studio-panel" class="studio-panel" aria-label={page.studio.panelAriaLabel}>
    <div class="drawer-head">
      <span class="drawer-grip" aria-hidden="true"></span>
      <button type="button" id="studio-drawer-close" class="drawer-close" aria-label={page.studio.closePanelAriaLabel}>✕</button>
    </div>

    <div class="field">
      <h1 class="panel-title">{page.studio.panelTitle}</h1>
      <p class="panel-intro">
        {page.studio.panelIntro}
      </p>
    </div>

    <div class="field">
      <label class="field-label" for="tpl-titleMain">{page.studio.titleMainLabel}</label>
      <textarea class="input" id="tpl-titleMain" rows="2">{fund.titleMain}</textarea>
    </div>

    <div class="field">
      <label class="field-label" for="tpl-titleAccent">{page.studio.titleAccentLabel}</label>
      <input class="input input--accent" id="tpl-titleAccent" type="text" value={fund.titleAccent} />
    </div>

    <div class="field">
      <label class="field-label" for="tpl-desc">{page.studio.descLabel}</label>
      <textarea class="input" id="tpl-desc" rows="3">{fund.desc}</textarea>
    </div>

    <div class="field-row">
      <div class="field">
        <label class="field-label" for="tpl-goal">{page.studio.goalLabel}</label>
        <input class="input" id="tpl-goal" type="number" value={fund.goal} />
      </div>
      <div class="field">
        <label class="field-label" for="tpl-raised">{page.studio.raisedLabel}</label>
        <input class="input" id="tpl-raised" type="number" value={fund.raised} />
      </div>
    </div>

    <div class="panel-bar"><span data-bar style={`width:${percent}%`}></span></div>
    <div class="panel-figures">
      <span class="raised" data-bind="raisedFmt">{raisedFmt}</span>
      <span><span data-bind="percent">{percent}</span>%</span>
      <span data-bind="goalFmt">{goalFmt}</span>
    </div>

    <div class="panel-photo">
      <span class="field-label">{page.studio.photoLabel}</span>
      <label class="dropzone" id="tpl-photo-drop">
        <input id="tpl-photo" type="file" accept="image/*" class="dropzone-input" />
        <span class="dropzone-thumb" id="tpl-photo-thumb" aria-hidden="true"></span>
        <span class="dropzone-body">
          <svg class="dropzone-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <span class="dropzone-text dropzone-text--empty">
            <span class="dropzone-title">{page.studio.dropzoneTitleEmpty}</span>
            <span class="dropzone-hint">{page.studio.dropzoneHintEmpty}</span>
          </span>
          <span class="dropzone-text dropzone-text--filled">
            <span class="dropzone-title">{page.studio.dropzoneTitleFilled}</span>
            <span class="dropzone-hint">{page.studio.dropzoneHintFilled}</span>
          </span>
        </span>
      </label>
      <!-- cover ⇄ contain for the shared photo: `cover` fills every slot with
           no empty gaps (edges get cropped), `contain` fits the whole photo in.
           The client script mirrors the choice onto every [data-photo] slot. -->
      <div class="panel-photo-fit">
        <span class="field-label" id="tpl-photo-fit-label">{page.studio.photoFitLabel}</span>
        <div class="photo-fit" id="tpl-photo-fit" role="group" aria-labelledby="tpl-photo-fit-label">
          <button type="button" class="photo-fit-btn" data-photo-fit="cover" aria-pressed="false">{page.studio.photoFitCoverLabel}</button>
          <button type="button" class="photo-fit-btn is-active" data-photo-fit="contain" aria-pressed="true">{page.studio.photoFitContainLabel}</button>
        </div>
        <p class="panel-intro panel-intro--mini">{page.studio.photoFitHint}</p>
      </div>
      <div class="panel-photo-row">
        <button type="button" id="tpl-photo-clear" class="ghost-btn" style="display:none">{page.studio.clearPhotoLabel}</button>
      </div>
    </div>

    <div class="panel-colors">
      <div class="panel-colors-head">
        <span class="field-label">{page.studio.colorsTitle}</span>
        <button type="button" id="tpl-colors-reset" class="ghost-btn ghost-btn--mini">{page.studio.colorsResetLabel}</button>
      </div>
      <div class="swatch-grid">
        <label class="swatch"><input type="color" data-color="ink" value="#0d0c0c" /><span>{page.studio.swatchInkLabel}</span></label>
        <label class="swatch"><input type="color" data-color="chalk" value="#f5f1ec" /><span>{page.studio.swatchChalkLabel}</span></label>
        <label class="swatch"><input type="color" data-color="pink" value="#ff2e88" /><span>{page.studio.swatchPinkLabel}</span></label>
        <label class="swatch"><input type="color" data-color="acid" value="#c9e400" /><span>{page.studio.swatchAcidLabel}</span></label>
        <label class="swatch"><input type="color" data-color="bubble" value="#f4a6e3" /><span>{page.studio.swatchBubbleLabel}</span></label>
      </div>
    </div>

    <div class="panel-labels">
      <div class="panel-labels-head">
        <span class="field-label">{page.studio.labelsTitle}</span>
        <button type="button" id="tpl-labels-reset" class="ghost-btn ghost-btn--mini">{page.studio.labelsResetLabel}</button>
      </div>
      <p class="panel-intro panel-intro--mini">{page.studio.labelsIntro}</p>
      <div class="label-grid">
        <div class="field">
          <label class="field-label" for="tpl-label-collect">БЕЙДЖ «ЗБІР НА»</label>
          <input class="input" id="tpl-label-collect" type="text" data-label-input="collect" value={page.studio.labels.collect} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-active">КІКЕР «АКТИВНИЙ ЗБІР»</label>
          <input class="input" id="tpl-label-active" type="text" data-label-input="active" value={page.studio.labels.active} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-urgent">КІКЕР «ТЕРМІНОВО»</label>
          <input class="input" id="tpl-label-urgent" type="text" data-label-input="urgent" value={page.studio.labels.urgent} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-checks">БЕЙДЖ «ЧЕКИ · ФОТО»</label>
          <input class="input" id="tpl-label-checks" type="text" data-label-input="checks" value={page.studio.labels.checks} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-handover">БЕЙДЖ «ПЕРЕДАНО»</label>
          <input class="input" id="tpl-label-handover" type="text" data-label-input="handover" value={page.studio.labels.handover} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-closedKicker">КІКЕР «ЗБІР ЗАКРИТО»</label>
          <input class="input" id="tpl-label-closedKicker" type="text" data-label-input="closedKicker" value={page.studio.labels.closedKicker} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-closed">БЕЙДЖ «ЗАКРИТО»</label>
          <input class="input" id="tpl-label-closed" type="text" data-label-input="closed" value={page.studio.labels.closed} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-collected">КІКЕР «ВЖЕ ЗІБРАНО»</label>
          <input class="input" id="tpl-label-collected" type="text" data-label-input="collected" value={page.studio.labels.collected} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-thermo">КІКЕР «ТЕРМОМЕТР»</label>
          <input class="input" id="tpl-label-thermo" type="text" data-label-input="thermo" value={page.studio.labels.thermo} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-equator">БЕЙДЖ «ЕКВАТОР»</label>
          <input class="input" id="tpl-label-equator" type="text" data-label-input="equator" value={page.studio.labels.equator} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-deadline">КІКЕР «ЗАКРИВАЄМО СЬОГОДНІ»</label>
          <input class="input" id="tpl-label-deadline" type="text" data-label-input="deadline" value={page.studio.labels.deadline} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-lastDay">ТЕКСТ «ОСТАННІЙ ДЕНЬ»</label>
          <input class="input" id="tpl-label-lastDay" type="text" data-label-input="lastDay" value={page.studio.labels.lastDay} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-checksWeekly">БЕЙДЖ «ЧЕКИ» (ЗВІТ ТИЖНЯ)</label>
          <input class="input" id="tpl-label-checksWeekly" type="text" data-label-input="checksWeekly" value={page.studio.labels.checksWeekly} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-giftKicker">КІКЕР «ПОДАРУНКИ ЗА ДОНАТИ»</label>
          <input class="input" id="tpl-label-giftKicker" type="text" data-label-input="giftKicker" value={page.studio.labels.giftKicker} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-giftHeadline">ЗАГОЛОВОК «ЯКІ ПОДАРУНКИ»</label>
          <input class="input" id="tpl-label-giftHeadline" type="text" data-label-input="giftHeadline" value={page.studio.labels.giftHeadline} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-giftPreview">КІКЕР «ПРЕВʼЮ ПОДАРУНКІВ»</label>
          <input class="input" id="tpl-label-giftPreview" type="text" data-label-input="giftPreview" value={page.studio.labels.giftPreview} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-giftList">БЕЙДЖ «СПИСОК ПОДАРУНКІВ»</label>
          <input class="input" id="tpl-label-giftList" type="text" data-label-input="giftList" value={page.studio.labels.giftList} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-giftItem1">ПОЗИЦІЯ 01</label>
          <input class="input" id="tpl-label-giftItem1" type="text" data-label-input="giftItem1" value={page.studio.labels.giftItem1} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-giftItem2">ПОЗИЦІЯ 02</label>
          <input class="input" id="tpl-label-giftItem2" type="text" data-label-input="giftItem2" value={page.studio.labels.giftItem2} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-giftItem3">ПОЗИЦІЯ 03</label>
          <input class="input" id="tpl-label-giftItem3" type="text" data-label-input="giftItem3" value={page.studio.labels.giftItem3} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-giftItem4">ПОЗИЦІЯ 04</label>
          <input class="input" id="tpl-label-giftItem4" type="text" data-label-input="giftItem4" value={page.studio.labels.giftItem4} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-giftFor">ТЕКСТ «ПОДАРУНКИ ЗА ДОНАТ»</label>
          <input class="input" id="tpl-label-giftFor" type="text" data-label-input="giftFor" value={page.studio.labels.giftFor} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-giftBrigade">КІКЕР «ПОДАРУНКИ ЗА ДОНАТ»</label>
          <input class="input" id="tpl-label-giftBrigade" type="text" data-label-input="giftBrigade" value={page.studio.labels.giftBrigade} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportKicker">КІКЕР «ЗВІТ ПРО ЗБІР»</label>
          <input class="input" id="tpl-label-reportKicker" type="text" data-label-input="reportKicker" value={page.studio.labels.reportKicker} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportRaisedTitle">ПІДПИС «ЗІБРАЛИ РАЗОМ»</label>
          <input class="input" id="tpl-label-reportRaisedTitle" type="text" data-label-input="reportRaisedTitle" value={page.studio.labels.reportRaisedTitle} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportBoughtTitle">ПІДПИС «ЩО ПРИДБАЛИ»</label>
          <input class="input" id="tpl-label-reportBoughtTitle" type="text" data-label-input="reportBoughtTitle" value={page.studio.labels.reportBoughtTitle} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportBought1">ПРИДБАЛИ · ПОЗИЦІЯ 01</label>
          <input class="input" id="tpl-label-reportBought1" type="text" data-label-input="reportBought1" value={page.studio.labels.reportBought1} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportBought2">ПРИДБАЛИ · ПОЗИЦІЯ 02</label>
          <input class="input" id="tpl-label-reportBought2" type="text" data-label-input="reportBought2" value={page.studio.labels.reportBought2} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportBought3">ПРИДБАЛИ · ПОЗИЦІЯ 03</label>
          <input class="input" id="tpl-label-reportBought3" type="text" data-label-input="reportBought3" value={page.studio.labels.reportBought3} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportBought4">ПРИДБАЛИ · ПОЗИЦІЯ 04</label>
          <input class="input" id="tpl-label-reportBought4" type="text" data-label-input="reportBought4" value={page.studio.labels.reportBought4} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportSourceTitle">ПІДПИС «ЗВІДКИ ЗІБРАЛИ»</label>
          <input class="input" id="tpl-label-reportSourceTitle" type="text" data-label-input="reportSourceTitle" value={page.studio.labels.reportSourceTitle} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportSource1">ДЖЕРЕЛО 01</label>
          <input class="input" id="tpl-label-reportSource1" type="text" data-label-input="reportSource1" value={page.studio.labels.reportSource1} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportSource2">ДЖЕРЕЛО 02</label>
          <input class="input" id="tpl-label-reportSource2" type="text" data-label-input="reportSource2" value={page.studio.labels.reportSource2} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportSource3">ДЖЕРЕЛО 03</label>
          <input class="input" id="tpl-label-reportSource3" type="text" data-label-input="reportSource3" value={page.studio.labels.reportSource3} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportDelivered">БЕЙДЖ «ПЕРЕДАНО БРИГАДІ»</label>
          <input class="input" id="tpl-label-reportDelivered" type="text" data-label-input="reportDelivered" value={page.studio.labels.reportDelivered} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportThanks">ЗАГОЛОВОК ПОДЯКИ У ЗВІТІ</label>
          <input class="input" id="tpl-label-reportThanks" type="text" data-label-input="reportThanks" value={page.studio.labels.reportThanks} />
        </div>
        <div class="field">
          <label class="field-label" for="tpl-label-reportThanksBody">ТЕКСТ ПОДЯКИ У ЗВІТІ</label>
          <textarea class="input" id="tpl-label-reportThanksBody" rows="2" data-label-input="reportThanksBody">{page.studio.labels.reportThanksBody}</textarea>
        </div>
      </div>
    </div>
  </aside>

  <!-- ============ GALLERY ============ -->
  <main class="gallery">
    <div class="studio-alert" role="note">
      <svg class="studio-alert-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <p>
        <strong>{page.studio.alertLead}</strong> {page.studio.alertBody}
      </p>
    </div>

    <!-- POST: ANNOUNCE -->
    <div class="tpl">
      <div class="tpl-cap">ПОСТ · АНОНС ЗБОРУ · 1080×1350</div>
      <div class="tpl-preview" style="width:356px;height:445px;border:1px solid var(--c-line);">
        <div class="tpl-scale">
          <div id="vgx-announce" class="canvas" style="width:1080px;height:1350px;background:var(--c-ink);padding:80px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;position:relative;">
              <TemplateLockup layout="stack" color="var(--c-chalk)" vSize={30} gSize={34} rotate={-5} />
            </div>
            <div style="display:flex;gap:44px;align-items:stretch;position:relative;">
              <div style="flex:1;display:flex;flex-direction:column;gap:28px;justify-content:center;min-width:0;">
                <div style="font-family:'Oswald',sans-serif;font-weight:700;letter-spacing:0.02em;font-size:80px;line-height:1;color:var(--c-chalk);"><span style="white-space:pre-line;" data-bind="titleMain">{fund.titleMain}</span><br /><span style="color:var(--c-bubble);" data-bind="titleAccent">{fund.titleAccent}</span></div>
                <p style="margin:0;font-size:30px;line-height:1.5;color:var(--c-dust);" data-bind="desc">{fund.desc}</p>
              </div>
              <div data-photo-slot data-export-optional="photo" style="width:360px;flex-shrink:0;position:relative;border:8px solid var(--c-bubble);overflow:hidden;">
                <div role="img" aria-label="Фото товару" data-photo style="position:absolute;inset:0;background-size:contain;background-position:center;background-repeat:no-repeat;display:none;"></div>
                <div data-nophoto style="position:absolute;inset:0;background:repeating-linear-gradient(45deg,var(--c-panel2),var(--c-panel2) 20px,var(--c-ink) 20px,var(--c-ink) 40px);display:flex;align-items:center;justify-content:center;text-align:center;padding:24px;">
                  <span style="font-family:'IBM Plex Mono',monospace;font-size:24px;color:var(--c-dust);line-height:1.5;">ФОТО<br />ЩО КУПУЄМО<br /><span style="font-size:18px;">· за бажанням ·</span></span>
                </div>
                <div style="position:absolute;left:0;bottom:0;background:var(--c-bubble);color:var(--c-ink);font-family:'IBM Plex Mono',monospace;font-size:22px;font-weight:500;padding:10px 18px;letter-spacing:0.08em;"><span data-label="collect">ЗБІР НА</span> ↓</div>
              </div>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;position:relative;">
              <div style="background:var(--c-bubble);color:var(--c-ink);font-family:'Unbounded',sans-serif;font-weight:800;font-size:34px;padding:28px 44px;">Ціль: <span data-bind="goalFmt">{goalFmt}</span></div>
              <div style="font-family:'IBM Plex Mono',monospace;font-size:24px;color:var(--c-dust);">банка → лінк у біо</div>
            </div>
          </div>
        </div>
      </div>
      <div class="tpl-actions">
        <button type="button" class="dl-btn" data-dl="announce">↓ PNG</button>
        <button type="button" class="cp-btn" data-cp="announce">⧉ Копіювати</button>
        <span class="tpl-status" data-status="announce"></span>
      </div>
    </div>

